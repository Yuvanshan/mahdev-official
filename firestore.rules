rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // GLOBAL DEFAULT-DENY SAFETY NET
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // CORE PRIMITIVES & SECURITY HELPERS
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role Hierarchy Resolution from trusted users collection
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isDedicatedAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function getUserRole() {
      return hasUserDoc() ? getUserDoc().role : (isDedicatedAdmin() ? 'admin' : 'customer');
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        getUserRole() == 'superAdmin' || 
        isDedicatedAdmin() ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'yuvanshan875@gmail.com' ||
          request.auth.token.email == 'admin@mahdev.lk' ||
          request.auth.token.email.matches('(?i).*@(mahdev\\.lk|mahdevgroup\\.com)')
        ))
      );
    }

    function isAdmin() {
      return isSignedIn() && (isSuperAdmin() || getUserRole() == 'admin');
    }

    function isManager() {
      return isSignedIn() && (isAdmin() || getUserRole() == 'manager');
    }

    function isStaff() {
      return isSignedIn() && (isManager() || getUserRole() == 'staff');
    }

    // =========================================================================
    // 1. SITE & COMPANY SETTINGS (/settings/{settingId}, /companySettings/{settingId})
    // =========================================================================
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update: if isAdmin() || isStaff();
      allow delete: if isSuperAdmin();
    }

    match /companySettings/{settingId} {
      allow get, list: if true;
      allow create, update: if isAdmin() || isStaff();
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 2. DIVISIONS (/divisions/{divisionId})
    // =========================================================================
    match /divisions/{divisionId} {
      allow get, list: if true;
      allow create, update: if isAdmin() || isManager() || isStaff();
      allow delete: if isSuperAdmin() || isAdmin();
    }

    // =========================================================================
    // 3. SERVICES (/services/{serviceId})
    // =========================================================================
    match /services/{serviceId} {
      allow get, list: if true;
      allow create, update: if isAdmin() || isManager() || isStaff();
      allow delete: if isSuperAdmin() || isAdmin();
    }

    // =========================================================================
    // 4. PRODUCTS (/products/{productId})
    // =========================================================================
    match /products/{productId} {
      allow get, list: if true;
      allow create, update: if isAdmin() || isStaff();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // =========================================================================
    // 5. CATEGORIES (/categories/{categoryId})
    // =========================================================================
    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update: if isAdmin() || isStaff();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // =========================================================================
    // 6. PACKAGES (/packages/{packageId})
    // =========================================================================
    match /packages/{packageId} {
      allow get, list: if true;
      allow create, update: if isAdmin() || isStaff();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // =========================================================================
    // 7. COUPONS (/coupons/{couponId})
    // =========================================================================
    match /coupons/{couponId} {
      allow get, list: if true;
      allow create, update: if isAdmin() || isStaff();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // =========================================================================
    // 8. CUSTOM PAGES (/pages/{pageId})
    // =========================================================================
    match /pages/{pageId} {
      allow get, list: if true;
      allow create, update: if isAdmin() || isStaff();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // =========================================================================
    // 9. MILESTONES (/milestones/{milestoneId})
    // =========================================================================
    match /milestones/{milestoneId} {
      allow get, list: if true;
      allow create, update: if isAdmin() || isStaff() || isManager();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // =========================================================================
    // 10. TRUSTED COMPANIES (/trustedCompanies/{companyId})
    // =========================================================================
    match /trustedCompanies/{companyId} {
      allow get, list: if true;
      allow create, update: if isAdmin() || isStaff() || isManager();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // =========================================================================
    // 11. PORTFOLIO (/portfolio/{portfolioId})
    // =========================================================================
    match /portfolio/{portfolioId} {
      allow get, list: if true;
      allow create, update: if isAdmin() || isStaff();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // =========================================================================
    // 12. TESTIMONIALS (/testimonials/{testimonialId})
    // =========================================================================
    match /testimonials/{testimonialId} {
      allow get, list: if true;
      allow create: if true;
      allow update: if isAdmin() || isStaff();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // =========================================================================
    // 13. GALLERY (/gallery/{itemId})
    // =========================================================================
    match /gallery/{itemId} {
      allow get, list: if true;
      allow create, update: if isAdmin() || isStaff();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // =========================================================================
    // 14. ANNOUNCEMENTS & BANNERS (/announcements/{announcementId})
    // =========================================================================
    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create, update: if isAdmin() || isStaff();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // =========================================================================
    // 15. BOOKINGS (/bookings/{bookingId})
    // =========================================================================
    match /bookings/{bookingId} {
      allow get: if true;
      allow list: if isAdmin() || isStaff();
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // =========================================================================
    // 16. ORDERS (/orders/{orderId})
    // =========================================================================
    match /orders/{orderId} {
      allow get: if true;
      allow list: if isAdmin() || isStaff();
      allow create: if true;
      allow update: if true;
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // =========================================================================
    // 17. USERS (/users/{userId}) (Firebase Auth handles auth credentials)
    // =========================================================================
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin() || isStaff();
      allow list: if isAdmin() || isStaff();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isSuperAdmin();

      match /notifications/{notificationId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // =========================================================================
    // 18. PAYMENTS (/payments/{paymentId}) (No sensitive card data)
    // =========================================================================
    match /payments/{paymentId} {
      allow get: if isSignedIn() || isAdmin();
      allow list: if isAdmin() || isStaff();
      allow create, update: if true;
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 19. CONTACT SUBMISSIONS (/contactSubmissions/{submissionId})
    // =========================================================================
    match /contactSubmissions/{submissionId} {
      allow get, list: if isAdmin() || isStaff();
      allow create: if true;
      allow update, delete: if isAdmin() || isSuperAdmin();
    }

    // =========================================================================
    // 20. AUDIT LOGS (/auditLogs/{logId}) (Restricted & Immutable)
    // =========================================================================
    match /auditLogs/{logId} {
      allow get, list: if isAdmin() || isStaff();
      allow create: if true;
      allow update, delete: if false; // Strict immutable audit trail
    }

    // =========================================================================
    // 21. DEDICATED ADMINS (/admins/{adminId})
    // =========================================================================
    match /admins/{adminId} {
      allow get, list: if isAdmin() || isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }
  }
}
