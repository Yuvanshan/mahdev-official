rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // 1. SITE & COMPANY SETTINGS (/settings/{settingId}, /companySettings/{settingId})
    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /companySettings/{settingId} {
      allow read, write: if true;
    }

    // 2. DIVISIONS (/divisions/{divisionId})
    match /divisions/{divisionId} {
      allow read, write: if true;
    }

    // 3. SERVICES (/services/{serviceId})
    match /services/{serviceId} {
      allow read, write: if true;
    }

    // 4. PRODUCTS (/products/{productId})
    match /products/{productId} {
      allow read, write: if true;
    }

    // 5. CATEGORIES (/categories/{categoryId})
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // 6. MILESTONES (/milestones/{milestoneId})
    match /milestones/{milestoneId} {
      allow read, write: if true;
    }

    // 7. TRUSTED COMPANIES (/trustedCompanies/{companyId})
    match /trustedCompanies/{companyId} {
      allow read, write: if true;
    }

    // 8. PORTFOLIO (/portfolio/{portfolioId})
    match /portfolio/{portfolioId} {
      allow read, write: if true;
    }

    // 9. TESTIMONIALS (/testimonials/{testimonialId})
    match /testimonials/{testimonialId} {
      allow read, write: if true;
    }

    // 10. GOOGLE REVIEWS & CONFIG
    match /googleReviews/{reviewId} {
      allow read, write: if true;
    }

    match /googleReviewsConfig/{docId} {
      allow read, write: if true;
    }

    // 11. GALLERY (/gallery/{itemId})
    match /gallery/{itemId} {
      allow read, write: if true;
    }

    // 12. BOOKINGS (/bookings/{bookingId})
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // 13. ORDERS (/orders/{orderId})
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // 14. USERS & SUB-COLLECTIONS (/users/{userId})
    match /users/{userId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // 15. PAYMENTS (/payments/{paymentId})
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // 16. CONTACT SUBMISSIONS (/contactSubmissions/{submissionId})
    match /contactSubmissions/{submissionId} {
      allow read, write: if true;
    }

    // 17. ANNOUNCEMENTS (/announcements/{announcementId})
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // 18. NAVIGATION (/navigation/{navId})
    match /navigation/{navId} {
      allow read, write: if true;
    }

    // 19. HERO SECTIONS (/heroSections/{heroId})
    match /heroSections/{heroId} {
      allow read, write: if true;
    }

    // 20. PAGES (/pages/{pageId})
    match /pages/{pageId} {
      allow read, write: if true;
    }

    // 21. PROJECTS (/projects/{projectId})
    match /projects/{projectId} {
      allow read, write: if true;
    }

    // 22. STATISTICS (/statistics/{statId})
    match /statistics/{statId} {
      allow read, write: if true;
    }

    // 23. CLIENTS (/clients/{clientId})
    match /clients/{clientId} {
      allow read, write: if true;
    }

    // 24. TEAM (/team/{memberId})
    match /team/{memberId} {
      allow read, write: if true;
    }

    // 25. FAQS (/faqs/{faqId})
    match /faqs/{faqId} {
      allow read, write: if true;
    }

    // 26. BLOG (/blog/{postId})
    match /blog/{postId} {
      allow read, write: if true;
    }

    // 27. CONTACT MESSAGES (/contactMessages/{messageId})
    match /contactMessages/{messageId} {
      allow read, write: if true;
    }

    // 28. INQUIRIES (/inquiries/{inquiryId})
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // 29. AUDIT LOGS (/auditLogs/{logId})
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // 30. ADMINS (/admins/{adminId})
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // 31. WEBSITE CONTENT (/websiteContent/{contentId})
    match /websiteContent/{contentId} {
      allow read, write: if true;
    }

    // 32. LEGAL PAGES (/legalPages/{pageId})
    match /legalPages/{pageId} {
      allow read, write: if true;
    }

    // GLOBAL FALLBACK for any other collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
