{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "buildCommand": "vite build && tsx scripts/prerender-seo.ts",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:alias(sws-event-management|sws-events|sws-event|event-management|events-management|events|decorations|decor)",
      "destination": "/sws",
      "permanent": true
    },
    {
      "source": "/:alias([sS][wW][sS](?:(?:[-_]|%20)?[a-zA-Z0-9]+)+|SWS|Sws)",
      "destination": "/sws",
      "permanent": true
    },
    {
      "source": "/:alias(u1-studio|u1-cinema|studio|photography|cinema)",
      "destination": "/u1",
      "permanent": true
    },
    {
      "source": "/:alias(it-solutions|mahdev-it|solutions|software|it-services)",
      "destination": "/it",
      "permanent": true
    },
    {
      "source": "/:alias(mahdev-travels|tourism|tours|travel)",
      "destination": "/travels",
      "permanent": true
    },
    {
      "source": "/:alias(online-mart|mahdev-mart|shop|store)",
      "destination": "/mart",
      "permanent": true
    },
    {
      "source": "/:prefix(divisions|division)/:id(sws|u1|it|travels|mart)",
      "destination": "/:id",
      "permanent": true
    },
    {
      "source": "/:alias(about-us|company)",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/:alias(projects|work)",
      "destination": "/portfolio",
      "permanent": true
    },
    {
      "source": "/journey",
      "destination": "/milestones",
      "permanent": true
    },
    {
      "source": "/reviews",
      "destination": "/testimonials",
      "permanent": true
    },
    {
      "source": "/jobs",
      "destination": "/careers",
      "permanent": true
    },
    {
      "source": "/:alias(partners|companies)",
      "destination": "/clients",
      "permanent": true
    },
    {
      "source": "/promotion",
      "destination": "/promotions",
      "permanent": true
    },
    {
      "source": "/featured-services",
      "destination": "/services",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "/api/firebase-auth/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/public/snapshot",
      "has": [
        {
          "type": "header",
          "key": "sec-fetch-site",
          "value": "(cross-site|same-site|none)"
        }
      ],
      "destination": "/api/page-shell?route=/__denied"
    },
    {
      "source": "/api/:area(database|data|analytics)/:rest*",
      "has": [
        {
          "type": "header",
          "key": "sec-fetch-site",
          "value": "(cross-site|same-site|none)"
        }
      ],
      "destination": "/api/page-shell?route=/__denied"
    },
    {
      "source": "/api/public/snapshot",
      "missing": [
        {
          "type": "header",
          "key": "sec-fetch-site"
        },
        {
          "type": "header",
          "key": "referer"
        }
      ],
      "destination": "/api/page-shell?route=/__denied"
    },
    {
      "source": "/api/:area(database|data|analytics)/:rest*",
      "missing": [
        {
          "type": "header",
          "key": "sec-fetch-site"
        },
        {
          "type": "header",
          "key": "referer"
        }
      ],
      "destination": "/api/page-shell?route=/__denied"
    },
    {
      "source": "/api/:first/:path*",
      "destination": "/api/[...path]"
    },
    {
      "source": "/:route(divisions|sws|u1|it|travels|mart|services|insights|catalog|book|about|portfolio|milestones|testimonials|careers|clients|contact|promotions|privacy-policy|terms-and-conditions|refund-policy|shipping-policy|cookie-policy)",
      "destination": "/:route/index.html"
    },
    {
      "source": "/admin-yuvan1709",
      "destination": "/app-shell.html"
    },
    {
      "source": "/admin-yuvan1709/:path*",
      "destination": "/app-shell.html"
    },
    {
      "source": "/favicon.ico",
      "destination": "/favicon.png"
    },
    {
      "source": "/:path((?!api/).*)",
      "destination": "/api/page-shell?route=/:path"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self), usb=()"
        }
      ]
    },
    {
      "source": "/((?!__/auth/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https:; script-src 'self' https://apis.google.com https://www.google.com https://www.gstatic.com https://www.recaptcha.net https://www.googletagmanager.com https://va.vercel-scripts.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' https://*.googleapis.com https://*.firebaseapp.com https://*.firebasestorage.app https://www.google.com https://www.gstatic.com https://www.recaptcha.net https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://vitals.vercel-insights.com https://va.vercel-scripts.com https://www.facebook.com https://connect.facebook.net; frame-src 'self' https://*.firebaseapp.com https://accounts.google.com https://*.google.com https://*.youtube.com https://*.youtube-nocookie.com https://player.vimeo.com https://www.recaptcha.net; worker-src 'self' blob:; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/admin-yuvan1709(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(admin|admin-login|adminlogin|adminportal|admin-portal)(/.*)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/uploads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/logo.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/favicon.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=31536000, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
