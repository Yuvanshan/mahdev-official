{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account document in the system",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "description": "Full display name" },
        "email": { "type": "string", "format": "email", "description": "Primary email address" },
        "phone": { "type": "string", "description": "Phone number" },
        "photoURL": { "type": "string", "description": "Profile picture URL" },
        "role": { "type": "string", "enum": ["customer", "staff", "manager", "admin", "superAdmin"], "description": "RBAC user role" },
        "status": { "type": "string", "enum": ["active", "suspended", "pending"], "description": "Account status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp" }
      },
      "required": ["uid", "email", "role", "status", "createdAt"]
    },
    "Role": {
      "title": "Role",
      "description": "Role permissions definition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Role identifier" },
        "name": { "type": "string", "description": "Role display name" },
        "permissions": { "type": "array", "description": "List of permission keys" },
        "description": { "type": "string", "description": "Role description" }
      },
      "required": ["id", "name"]
    },
    "Division": {
      "title": "Division",
      "description": "Mahdev enterprise business division",
      "type": "object",
      "properties": {
        "id": { "type": "string", "enum": ["sws", "u1", "it", "travels", "mart"], "description": "Division key" },
        "name": { "type": "string", "description": "Division full name" },
        "slug": { "type": "string", "description": "URL slug" },
        "description": { "type": "string", "description": "Division overview and mission" },
        "logo": { "type": "string", "description": "Division logo asset URL" },
        "hero": { "type": "object", "description": "Hero banner visual and copy settings" },
        "status": { "type": "string", "enum": ["active", "inactive", "maintenance"], "description": "Operational status" },
        "seo": { "type": "object", "description": "Division specific SEO metadata" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["id", "name", "slug", "status"]
    },
    "Service": {
      "title": "Service",
      "description": "Service offering belonging to a division",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Service ID" },
        "division": { "type": "string", "description": "Associated division ID" },
        "name": { "type": "string", "description": "Service name" },
        "slug": { "type": "string", "description": "Service URL slug" },
        "description": { "type": "string", "description": "Detailed description" },
        "images": { "type": "array", "description": "List of image URLs" },
        "price": { "type": "number", "description": "Starting or base price" },
        "status": { "type": "string", "enum": ["active", "inactive", "draft"], "description": "Service status" },
        "bookingEnabled": { "type": "boolean", "description": "Whether direct booking is enabled" },
        "quoteEnabled": { "type": "boolean", "description": "Whether custom quote request is enabled" },
        "metadata": { "type": "object", "description": "Division-specific parameters and packages" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "division", "name", "status"]
    },
    "Product": {
      "title": "Product",
      "description": "Physical or digital product catalog item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Product ID" },
        "division": { "type": "string", "description": "Associated division (e.g. mart, it, sws)" },
        "name": { "type": "string", "description": "Product name" },
        "slug": { "type": "string", "description": "Product slug" },
        "sku": { "type": "string", "description": "Stock Keeping Unit" },
        "categoryId": { "type": "string", "description": "Primary category ID" },
        "description": { "type": "string", "description": "Product description" },
        "price": { "type": "number", "description": "Base price" },
        "compareAtPrice": { "type": "number", "description": "Original price before discount" },
        "images": { "type": "array", "description": "Gallery of product image URLs" },
        "stock": { "type": "number", "description": "Current available inventory quantity" },
        "status": { "type": "string", "enum": ["active", "draft", "out_of_stock", "archived"] },
        "hasVariants": { "type": "boolean", "description": "Whether item has variants" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "division", "name", "price", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "Product or service category",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Category ID" },
        "division": { "type": "string", "description": "Division ID" },
        "name": { "type": "string", "description": "Category name" },
        "slug": { "type": "string", "description": "Category slug" },
        "description": { "type": "string", "description": "Category description" },
        "imageUrl": { "type": "string", "description": "Category visual thumbnail" },
        "order": { "type": "number", "description": "Sort display order" },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      },
      "required": ["id", "division", "name", "slug"]
    },
    "ProductVariant": {
      "title": "ProductVariant",
      "description": "Variant option for a product (size, color, tier, specs)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Variant ID" },
        "productId": { "type": "string", "description": "Parent product ID" },
        "name": { "type": "string", "description": "Variant option label" },
        "sku": { "type": "string", "description": "Variant specific SKU" },
        "price": { "type": "number", "description": "Variant price override" },
        "stock": { "type": "number", "description": "Variant stock count" },
        "attributes": { "type": "object", "description": "Key-value attributes" }
      },
      "required": ["id", "productId", "name", "price"]
    },
    "Inventory": {
      "title": "Inventory",
      "description": "Stock tracking record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Inventory ID" },
        "productId": { "type": "string", "description": "Product reference ID" },
        "variantId": { "type": "string", "description": "Optional variant ID" },
        "quantityAvailable": { "type": "number", "description": "Available stock count" },
        "quantityReserved": { "type": "number", "description": "Reserved count in pending carts/orders" },
        "lowStockThreshold": { "type": "number", "description": "Alert trigger threshold" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "productId", "quantityAvailable"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Reservation and service appointment document",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Booking reference code" },
        "customerId": { "type": "string", "description": "Customer UID or anonymous ID" },
        "customer": { "type": "object", "description": "Customer contact info snapshot" },
        "divisionId": { "type": "string", "description": "Division ID" },
        "serviceId": { "type": "string", "description": "Service ID" },
        "packageId": { "type": "string", "description": "Selected package or tier ID" },
        "date": { "type": "string", "description": "Scheduled date (YYYY-MM-DD)" },
        "time": { "type": "string", "description": "Scheduled time window" },
        "location": { "type": "object", "description": "Venue address and city details" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "in_progress", "completed", "cancelled"], "description": "Booking status" },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "deposit_paid", "paid", "refunded"], "description": "Payment status" },
        "price": { "type": "number", "description": "Agreed booking price" },
        "currency": { "type": "string", "description": "Currency code (e.g. USD, LKR)" },
        "notes": { "type": "string", "description": "Special client requirements" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "divisionId", "serviceId", "date", "status", "price"]
    },
    "Order": {
      "title": "Order",
      "description": "E-commerce and merchandise sales order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Order reference code (e.g. ORD-2026-XXXX)" },
        "customerId": { "type": "string", "description": "Customer UID or guest ID" },
        "customer": { "type": "object", "description": "Customer contact information" },
        "items": { "type": "array", "description": "Ordered line items array" },
        "subtotal": { "type": "number", "description": "Subtotal before discounts/shipping" },
        "discount": { "type": "number", "description": "Total discount amount" },
        "shippingFee": { "type": "number", "description": "Shipping cost" },
        "tax": { "type": "number", "description": "Tax amount" },
        "total": { "type": "number", "description": "Grand total payable" },
        "currency": { "type": "string", "description": "Currency code (USD / LKR)" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "processing", "shipped", "delivered", "cancelled"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid", "failed", "refunded"] },
        "shipping": { "type": "object", "description": "Shipping destination address and courier logistics" },
        "billing": { "type": "object", "description": "Billing address and tax info" },
        "appliedCouponCode": { "type": "string", "description": "Coupon code used" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "total", "status", "paymentStatus", "createdAt"]
    },
    "OrderItem": {
      "title": "OrderItem",
      "description": "Individual line item in an order",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Line item ID" },
        "orderId": { "type": "string", "description": "Associated order ID" },
        "productId": { "type": "string", "description": "Product ID" },
        "productName": { "type": "string", "description": "Product name" },
        "sku": { "type": "string", "description": "SKU" },
        "quantity": { "type": "number", "description": "Quantity purchased" },
        "unitPrice": { "type": "number", "description": "Unit price" },
        "lineTotal": { "type": "number", "description": "Line total" },
        "division": { "type": "string", "description": "Division identifier" }
      },
      "required": ["orderId", "productId", "quantity", "unitPrice", "lineTotal"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Transaction reference code" },
        "orderId": { "type": "string", "description": "Associated order ID" },
        "bookingId": { "type": "string", "description": "Optional booking ID" },
        "gatewayId": { "type": "string", "description": "Gateway identifier (stripe, lankapay, bank_transfer)" },
        "amount": { "type": "number", "description": "Transaction amount" },
        "currency": { "type": "string", "description": "Currency code" },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid", "failed", "cancelled", "refunded"] },
        "verificationResult": { "type": "object", "description": "HMAC / Auth verification record" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "amount", "paymentStatus", "timestamp"]
    },
    "Portfolio": {
      "title": "Portfolio",
      "description": "Showcase portfolio project",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Portfolio item ID" },
        "division": { "type": "string", "description": "Division ID" },
        "title": { "type": "string", "description": "Project title" },
        "client": { "type": "string", "description": "Client or brand name" },
        "category": { "type": "string", "description": "Category or genre" },
        "description": { "type": "string", "description": "Case study overview" },
        "imageUrl": { "type": "string", "description": "Cover image URL" },
        "featured": { "type": "boolean", "description": "Highlight on homepage" },
        "year": { "type": "string", "description": "Completion year" },
        "status": { "type": "string", "enum": ["published", "draft"] }
      },
      "required": ["id", "division", "title", "status"]
    },
    "Gallery": {
      "title": "Gallery",
      "description": "Media visual asset in photo/video gallery",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Gallery item ID" },
        "division": { "type": "string", "description": "Division ID" },
        "title": { "type": "string", "description": "Media caption/title" },
        "url": { "type": "string", "description": "Direct asset URL" },
        "type": { "type": "string", "enum": ["image", "video"] },
        "tag": { "type": "string", "description": "Filtering tag" },
        "status": { "type": "string", "enum": ["published", "hidden"] }
      },
      "required": ["id", "url", "type", "status"]
    },
    "Milestone": {
      "title": "Milestone",
      "description": "Company history and growth milestone",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Milestone ID" },
        "year": { "type": "string", "description": "Year (e.g. 2024)" },
        "title": { "type": "string", "description": "Milestone achievement title" },
        "description": { "type": "string", "description": "Achievement narrative" },
        "order": { "type": "number", "description": "Chronological order index" }
      },
      "required": ["id", "year", "title"]
    },
    "TrustedCompany": {
      "title": "TrustedCompany",
      "description": "Enterprise client or ecosystem partner logo",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Company ID" },
        "name": { "type": "string", "description": "Company name" },
        "logoUrl": { "type": "string", "description": "Logo URL" },
        "division": { "type": "string", "description": "Optional division association" },
        "tier": { "type": "string", "description": "Client tier (e.g. enterprise, partner)" },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      },
      "required": ["id", "name", "status"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Customer and client review endorsement",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Testimonial ID" },
        "author": { "type": "string", "description": "Client full name" },
        "role": { "type": "string", "description": "Client role or designation" },
        "company": { "type": "string", "description": "Client organization name" },
        "avatarUrl": { "type": "string", "description": "Author avatar photo" },
        "quote": { "type": "string", "description": "Testimonial review quote" },
        "division": { "type": "string", "description": "Associated division or 'all'" },
        "rating": { "type": "number", "description": "Star rating out of 5" },
        "status": { "type": "string", "enum": ["approved", "pending", "archived"] }
      },
      "required": ["id", "author", "quote", "rating", "status"]
    },
    "Page": {
      "title": "Page",
      "description": "Static or content page definition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Page identifier slug" },
        "title": { "type": "string", "description": "Page title" },
        "slug": { "type": "string", "description": "URL path" },
        "content": { "type": "string", "description": "Markdown or HTML content" },
        "seo": { "type": "object", "description": "Meta title, description, and keywords" },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "slug", "status"]
    },
    "CompanySettings": {
      "title": "CompanySettings",
      "description": "Mahdev centralized official corporate information",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Brand name" },
        "legalName": { "type": "string", "description": "Official legal name" },
        "registrationNumber": { "type": "string", "description": "Company registration ref" },
        "tagline": { "type": "string", "description": "Official motto" },
        "description": { "type": "string", "description": "Corporate summary" },
        "domain": { "type": "string", "description": "Official domain" },
        "email": { "type": "string", "format": "email", "description": "Official contact email" },
        "primaryPhone": { "type": "string", "description": "Primary hotline" },
        "secondaryPhone": { "type": "string", "description": "Secondary hotline" },
        "offices": { "type": "object", "description": "Colombo and Trincomalee office records" },
        "socials": { "type": "object", "description": "Social media channel links" },
        "workingHours": { "type": "object", "description": "Operational working hours" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "legalName", "email", "primaryPhone"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global website configuration options",
      "type": "object",
      "properties": {
        "siteName": { "type": "string", "description": "Website title" },
        "maintenanceMode": { "type": "boolean", "description": "Global maintenance flag" },
        "announcement": { "type": "object", "description": "Top bar announcement banner" },
        "currency": { "type": "string", "description": "Default currency code" },
        "taxRate": { "type": "number", "description": "Standard tax percentage" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["siteName"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional discount voucher",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Coupon code" },
        "code": { "type": "string", "description": "Uppercase coupon code" },
        "discountType": { "type": "string", "enum": ["percentage", "fixed"] },
        "discountValue": { "type": "number", "description": "Percentage (e.g. 10) or fixed amount ($)" },
        "minimumSpend": { "type": "number", "description": "Minimum subtotal required" },
        "expiryDate": { "type": "string", "description": "Expiration date (YYYY-MM-DD)" },
        "usageLimit": { "type": "number", "description": "Max usage count" },
        "usageCount": { "type": "number", "description": "Current times redeemed" },
        "status": { "type": "string", "enum": ["active", "expired", "disabled"] }
      },
      "required": ["code", "discountType", "discountValue", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System or user alert notification",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Notification ID" },
        "userId": { "type": "string", "description": "Target user UID or 'all'" },
        "title": { "type": "string", "description": "Alert title" },
        "message": { "type": "string", "description": "Alert message body" },
        "type": { "type": "string", "enum": ["info", "success", "warning", "order", "booking"] },
        "read": { "type": "boolean", "description": "Read status" },
        "link": { "type": "string", "description": "Target navigation link" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "message", "type", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Administrative security and mutation audit trail",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Log ID" },
        "actorId": { "type": "string", "description": "UID of admin/staff member" },
        "actorName": { "type": "string", "description": "Name of actor" },
        "action": { "type": "string", "description": "Action key (e.g. update_product, confirm_booking)" },
        "resourceType": { "type": "string", "description": "Target collection or resource" },
        "resourceId": { "type": "string", "description": "Target document ID" },
        "details": { "type": "object", "description": "Diff or payload details" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "actorName", "action", "timestamp"]
    },
    "ContactSubmission": {
      "title": "ContactSubmission",
      "description": "Inquiry form submission from the contact page or division CTA",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Inquiry ID" },
        "fullName": { "type": "string", "description": "Sender full name" },
        "email": { "type": "string", "format": "email", "description": "Sender email" },
        "phone": { "type": "string", "description": "Sender phone number" },
        "division": { "type": "string", "description": "Target division or general" },
        "subject": { "type": "string", "description": "Inquiry subject" },
        "message": { "type": "string", "description": "Inquiry body" },
        "status": { "type": "string", "enum": ["new", "in_review", "replied", "archived"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "email", "message", "status", "createdAt"]
    },
    "QuoteRequest": {
      "title": "QuoteRequest",
      "description": "Custom enterprise service or production quotation request",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Quote request reference ID" },
        "fullName": { "type": "string", "description": "Client name" },
        "company": { "type": "string", "description": "Organization/Company name" },
        "email": { "type": "string", "format": "email", "description": "Email" },
        "phone": { "type": "string", "description": "Phone" },
        "division": { "type": "string", "description": "Division key" },
        "serviceId": { "type": "string", "description": "Optional service ID" },
        "budgetRange": { "type": "string", "description": "Estimated budget bracket" },
        "timeline": { "type": "string", "description": "Target completion timeframe" },
        "specifications": { "type": "string", "description": "Scope and technical deliverables" },
        "status": { "type": "string", "enum": ["pending", "assessing", "quoted", "accepted", "declined"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "email", "division", "specifications", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profile records and authentication links"
    },
    "/roles/{roleId}": {
      "schema": "Role",
      "description": "Role definitions and permissions"
    },
    "/divisions/{divisionId}": {
      "schema": "Division",
      "description": "The 5 primary Mahdev business divisions"
    },
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Service catalog offerings across divisions"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Product merchandise catalog"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Taxonomy categories for products and services"
    },
    "/productVariants/{variantId}": {
      "schema": "ProductVariant",
      "description": "Product size, color, and specification variants"
    },
    "/inventory/{inventoryId}": {
      "schema": "Inventory",
      "description": "Inventory stock counts and low-threshold alerts"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Event and service reservations"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "E-commerce orders and invoice records"
    },
    "/orderItems/{orderItemId}": {
      "schema": "OrderItem",
      "description": "Itemized line breakdown records"
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Payment transactions and gateway audit logs"
    },
    "/portfolio/{portfolioId}": {
      "schema": "Portfolio",
      "description": "Showcase portfolio projects across divisions"
    },
    "/gallery/{galleryId}": {
      "schema": "Gallery",
      "description": "Photo and video showcase items"
