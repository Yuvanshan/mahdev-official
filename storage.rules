rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // =========================================================================
    // 1. HELPER FUNCTIONS
    // =========================================================================
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role verification supporting custom claims, token metadata, verified admin emails, or administrative staff
    function isStaff() {
      return isSignedIn() && (
        request.auth.token.role in ['staff', 'manager', 'admin', 'superAdmin', 'operations_admin', 'super_admin'] ||
        request.auth.token.admin == true ||
        request.auth.token.super_admin == true ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'admin@mahdev.lk' ||
          request.auth.token.email == 'operations@mahdev.lk' ||
          request.auth.token.email == 'sales@mahdev.lk' ||
          request.auth.token.email == 'yuvanshan875@gmail.com' ||
          request.auth.token.email.matches('.*@mahdev\\.lk$')
        ))
      );
    }

    // Content Type Validations
    function isValidImage() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
    }

    function isValidVectorOrImage() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp|svg\\+xml|x-icon|vnd\\.microsoft\\.icon|ico)');
    }

    function isValidVideo() {
      return request.resource.contentType.matches('video/(mp4|webm|ogg|quicktime|x-matroska)');
    }

    function isValidMedia() {
      return isValidVectorOrImage() || isValidVideo();
    }

    function isValidDoc() {
      return request.resource.contentType.matches('(application/pdf|image/jpeg|image/png|image/webp)');
    }

    // =========================================================================
    // 2. PUBLIC MARKETING, BRANDING & CATALOG ASSETS
    // =========================================================================
    match /branding/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff() && isValidMedia() && request.resource.size < 100 * 1024 * 1024;
    }

    match /company/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff() && isValidMedia() && request.resource.size < 100 * 1024 * 1024;
    }

    match /divisions/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff() && isValidMedia() && request.resource.size < 100 * 1024 * 1024;
    }

    match /videos/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff() && isValidVideo() && request.resource.size < 100 * 1024 * 1024;
    }

    match /services/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff() && isValidVectorOrImage() && request.resource.size < 10 * 1024 * 1024;
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff() && isValidVectorOrImage() && request.resource.size < 10 * 1024 * 1024;
    }

    match /portfolio/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff() && isValidMedia() && request.resource.size < 100 * 1024 * 1024;
    }

    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff() && isValidMedia() && request.resource.size < 100 * 1024 * 1024;
    }

    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff() && isValidMedia() && request.resource.size < 100 * 1024 * 1024;
    }

    match /general/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff() && isValidMedia() && request.resource.size < 100 * 1024 * 1024;
    }

    match /testimonials/{allPaths=**} {
      allow read: if true;
      // Authenticated users can submit testimonial photos (max 5MB), staff can moderate/delete
      allow create: if isSignedIn() && isValidImage() && request.resource.size < 5 * 1024 * 1024;
      allow update, delete: if isStaff();
    }

    // =========================================================================
    // 3. USER PROFILE ASSETS
    // =========================================================================
    match /users/{userId}/{allPaths=**} {
      allow read: if true; // Public display for user avatar
      allow write: if (isOwner(userId) || isStaff()) && isValidVectorOrImage() && request.resource.size < 5 * 1024 * 1024;
    }

    // =========================================================================
    // 4. PRIVATE ENTERPRISE DOCUMENTS & INVOICES
    // =========================================================================
    match /documents/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isStaff();
      allow write: if (isOwner(userId) || isStaff()) && isValidDoc() && request.resource.size < 20 * 1024 * 1024;
    }

    match /invoices/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isStaff();
      allow write: if isStaff() && isValidDoc() && request.resource.size < 20 * 1024 * 1024;
    }
  }
}

