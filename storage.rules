rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // =========================================================================
    // 1. HELPER FUNCTIONS
    // =========================================================================
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // An email only counts once its owner has verified it: anyone can create an
    // unverified account using someone else's address.
    function hasVerifiedEmail(emails) {
      return request.auth.token.email != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in emails;
    }

    // Role verification: custom claims, or one of the listed staff emails once verified.
    // (A pattern such as "any @mahdev.lk address" is not used: it would trust addresses
    // nobody has checked.)
    function isStaff() {
      return isSignedIn() && (
        request.auth.token.role in ['staff', 'manager', 'admin', 'superAdmin', 'operations_admin', 'super_admin'] ||
        request.auth.token.admin == true ||
        request.auth.token.super_admin == true ||
        hasVerifiedEmail(['admin@mahdev.lk', 'operations@mahdev.lk', 'sales@mahdev.lk', 'yuvanshan875@gmail.com'])
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role in ['admin', 'superAdmin', 'operations_admin', 'super_admin'] ||
        request.auth.token.admin == true ||
        request.auth.token.super_admin == true ||
        hasVerifiedEmail(['admin@mahdev.lk', 'operations@mahdev.lk', 'sales@mahdev.lk', 'yuvanshan875@gmail.com'])
      );
    }

    // Content Type Validations
    function isValidImage() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
    }

    // SVG is not accepted: an SVG file can contain script that runs when opened.
    function isValidVectorOrImage() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp|x-icon|vnd\\.microsoft\\.icon|ico)');
    }

    function isValidVideo() {
      return request.resource.contentType.matches('video/(mp4|webm|ogg|quicktime|x-matroska)');
    }

    function isValidMedia() {
      return isValidVectorOrImage() || isValidVideo();
    }

    function isValidDoc() {
      return request.resource.contentType.matches('(application/pdf|image/jpeg|image/png|image/webp)');
    }

    // =========================================================================
    // 2. PUBLIC MARKETING, BRANDING & CATALOG ASSETS
    // =========================================================================
    match /branding/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidMedia() && request.resource.size < 100 * 1024 * 1024;
    }

    match /company/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidMedia() && request.resource.size < 100 * 1024 * 1024;
    }

    match /divisions/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidMedia() && request.resource.size < 100 * 1024 * 1024;
    }

    match /videos/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidVideo() && request.resource.size < 100 * 1024 * 1024;
    }

    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidMedia() && request.resource.size < 50 * 1024 * 1024;
    }

    match /hero/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidMedia() && request.resource.size < 100 * 1024 * 1024;
    }

    match /uploads/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidMedia() && request.resource.size < 100 * 1024 * 1024;
    }

    match /services/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidVectorOrImage() && request.resource.size < 10 * 1024 * 1024;
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidVectorOrImage() && request.resource.size < 10 * 1024 * 1024;
    }

    match /portfolio/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidMedia() && request.resource.size < 100 * 1024 * 1024;
    }

    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidMedia() && request.resource.size < 100 * 1024 * 1024;
    }

    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidMedia() && request.resource.size < 100 * 1024 * 1024;
    }

    match /general/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidMedia() && request.resource.size < 100 * 1024 * 1024;
    }

    match /testimonials/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage() && request.resource.size < 5 * 1024 * 1024;
    }

    // =========================================================================
    // 3. USER PROFILE ASSETS
    // =========================================================================
    match /users/{userId}/{allPaths=**} {
      allow read: if true; // Public display for user avatar
      allow write: if isAdmin() && isValidVectorOrImage() && request.resource.size < 5 * 1024 * 1024;
    }

    // =========================================================================
    // 4. PRIVATE ENTERPRISE DOCUMENTS & INVOICES
    // =========================================================================
    match /documents/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isStaff();
      allow write: if isAdmin() && isValidDoc() && request.resource.size < 20 * 1024 * 1024;
    }

    match /invoices/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isStaff();
      allow write: if isAdmin() && isValidDoc() && request.resource.size < 20 * 1024 * 1024;
    }

    // CVs are served only through the admin-session-protected API endpoint.
    match /career-cvs/{allPaths=**} {
      allow read, write: if false;
    }

    // Bank transfer slips are uploaded and served only through /api/bookings/slip.
    match /booking-slips/{allPaths=**} {
      allow read, write: if false;
    }
  }
}
