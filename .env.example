# ==============================================================================
# MAHDEV PVT LTD — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: This file contains variable definitions and placeholders ONLY.
# NEVER commit actual secrets, API tokens, or private keys to source control.
#
# Environment Support:
# - Development: Local execution via `npm run dev`
# - Preview: Pull Request / Staging deployment on Cloud Run / Vercel Preview
# - Production: Production live cluster (https://mahdev.lk)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME (Server-Side)
# ------------------------------------------------------------------------------
# Node runtime environment mode: 'development' | 'test' | 'production'
NODE_ENV=

# Web server listening port (Hardcoded to 3000 in container proxy)
PORT=3000

# Canonical deployment URL (Injected by Cloud Run or Vercel)
# Example: https://mahdev.lk or https://ais-pre-xxx.asia-southeast1.run.app
APP_URL=

# ------------------------------------------------------------------------------
# 2. CLIENT-SIDE RUNTIME (Browser-Safe, 'VITE_' prefixed)
# ------------------------------------------------------------------------------
# Publicly accessible app origin for deep-links and OAuth redirects
VITE_APP_URL=

# ------------------------------------------------------------------------------
# 3. AI & INTELLIGENCE (Server-Side Only)
# ------------------------------------------------------------------------------
# Google Gemini API Key for server-side AI processing
# Configured via the AI Studio Secrets panel. Never expose to client.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 4. FIREBASE WEB SDK & APP CHECK (Browser-Safe)
# ------------------------------------------------------------------------------
# Firebase Web App Client configuration keys
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Named Firestore Database ID (if using custom named database instance)
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# reCAPTCHA v3 / Enterprise Site Key for Firebase App Check attestation
VITE_FIREBASE_RECAPTCHA_SITE_KEY=

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAYS & TRANSACTIONS (Server-Side Secrets)
# ------------------------------------------------------------------------------
# Payment engine mode: 'sandbox' (testing/simulation) | 'production' (live transactions)
PAYMENT_GATEWAY_ENV=sandbox

# Stripe Secret Key (e.g. sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=

# Secret key for verifying HMAC-SHA256 signatures on inbound payment webhooks
PAYMENT_WEBHOOK_SECRET=

# LankaPay / Sri Lanka National Interbank Payment Network Credentials
LANKAPAY_MERCHANT_ID=
LANKAPAY_SECRET_KEY=

# ------------------------------------------------------------------------------
# 6. ENTERPRISE CRYPTOGRAPHIC SECURITY & INTEGRITY (Server-Side Secrets)
# ------------------------------------------------------------------------------
# Salt used for administrative session token hashing and role validation
ADMIN_SECRET_SALT=

# HMAC key used to generate authoritative cryptographic signatures on verified orders
ORDER_SIGNATURE_SECRET=

# HMAC salt for tamper-proof fiscal tax invoice generation
INVOICE_SIGNING_SALT=

# Cryptographic salt for dispatching authenticated customer notifications
NOTIFICATION_SECRET_SALT=

# ------------------------------------------------------------------------------
# 7. COMMUNICATIONS & DISPATCH (Server-Side Secrets)
# ------------------------------------------------------------------------------
# Target inbox for website customer enquiries (Defaults to info.mahdev.lk@gmail.com)
ENQUIRY_TARGET_EMAIL=info.mahdev.lk@gmail.com

# SMTP Server configuration for transactional receipts & dispatch notifications
# For Gmail, configure either GMAIL_USER + GMAIL_APP_PASSWORD or SMTP_USER + SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=info.mahdev.lk@gmail.com

# Gmail App Password Configuration:
# 1. Open your Google Account at https://myaccount.google.com/security
# 2. Ensure 2-Step Verification is enabled.
# 3. Go to https://myaccount.google.com/apppasswords and create an App Password (e.g. "Mahdev Mailer")
# 4. Paste your 16-character generated password below without spaces.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_PASSWORD=

# Meta / WhatsApp Business Cloud API Credentials for order updates
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ------------------------------------------------------------------------------
# 8. ANALYTICS & TELEMETRY (Browser-Safe)
# ------------------------------------------------------------------------------
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# 9. MAPS & LOCATION SERVICES (Browser-Safe)
# ------------------------------------------------------------------------------
# Google Maps JavaScript API Key (restricted to authorized HTTP referrers)
VITE_GOOGLE_MAPS_API_KEY=
