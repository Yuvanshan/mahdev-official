{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test-runner.ts",
    "test:security": "tsx scripts/test-phase27-security.ts && tsx scripts/test-phase28-backend-services.ts && tsx scripts/test-security-rules.ts",
    "test:storage": "tsx scripts/test-storage-service.ts",
    "test:recovery": "tsx scripts/test-backup-recovery-drill.ts",
    "preflight": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "12.18.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.4",
    "stripe": "^22.5.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.63.2",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "lightningcss-win32-x64-msvc": "^1.33.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
