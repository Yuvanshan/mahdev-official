{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx backend/server.ts",
    "dev:frontend": "vite",
    "dev:backend": "tsx backend/server.ts",
    "build": "vite build && esbuild backend/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/backend.cjs",
    "start": "node dist/backend.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "db:migrate": "tsx backend/db/migrate.ts",
    "db:seed": "tsx backend/db/seed.ts",
    "migrate:turso": "tsx scripts/migrate-firestore-to-turso.ts",
    "admin:hash-password": "tsx scripts/generate-admin-password-hash.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test-runner.ts && tsx scripts/test-turso-database.ts && npx tsx backend/db/__tests__/db-structure.test.ts",
    "test:security": "tsx scripts/test-phase27-security.ts && tsx scripts/test-phase28-backend-services.ts && tsx scripts/test-security-rules.ts",
    "test:storage": "tsx scripts/test-storage-service.ts",
    "test:recovery": "tsx scripts/test-backup-recovery-drill.ts",
    "preflight": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "12.18.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.16",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.4",
    "stripe": "^22.5.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
